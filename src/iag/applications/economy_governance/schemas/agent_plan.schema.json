{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.iag/schemas/agent_plan.schema.json",
  "title": "IAG single-action construction plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_game_date",
    "assessment",
    "action",
    "reasoning_zh",
    "confidence",
    "next_review_months"
  ],
  "properties": {
    "schema": {
      "const": "iag.agent_plan.v1"
    },
    "source_game_date": {
      "type": ["string", "null"]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_level", "urgent_risks", "strategic_priority"],
      "properties": {
        "risk_level": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "urgent_risks": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "strategic_priority": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "noop"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "candidate_id"],
          "properties": {
            "type": {
              "const": "execute_candidate"
            },
            "candidate_id": {
              "type": "string",
              "pattern": "^iag_candidate_[a-f0-9]{16}$"
            }
          }
        }
      ]
    },
    "reasoning_zh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "next_review_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "evidence": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    }
  }
}
