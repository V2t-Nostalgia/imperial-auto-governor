{
  "schema": "iag.model_templates.v1",
  "templates": [
    {
      "id": "custom",
      "label": "自定义 OpenAI 兼容接口",
      "description": "保留当前 Base URL、模型和协议设置。工具会话目前使用 Chat Completions 兼容协议。",
      "config": {}
    },
    {
      "id": "deepseek_thinking_tools",
      "label": "DeepSeek 思考模式 + 建设工具",
      "description": "使用 DeepSeek 官方 Chat Completions 思考模式；模型只选择工具，本地程序负责校验和执行。",
      "config": {
        "model_transport": "openai_sdk",
        "provider": "chat_completions_compatible",
        "base_url": "https://api.deepseek.com",
        "chat_completions_path": "/chat/completions",
        "model": "deepseek-v4-pro",
        "supports_reasoning": true,
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "max",
        "sdk_max_retries": 2,
        "tool_calling_enabled": true,
        "model_context_window_tokens": 1000000,
        "context_output_reserve_tokens": 65536,
        "context_compression_enabled": true,
        "context_compression_trigger_percent": 80,
        "context_compression_target_percent": 35
      }
    }
  ]
}
