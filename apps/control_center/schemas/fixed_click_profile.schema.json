{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.iag/schemas/fixed_click_profile.schema.json",
  "title": "IAG fixed carrier click calibration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "window", "target", "guard", "source_capture"],
  "properties": {
    "schema": {"const": "iag.fixed_click_profile.v1"},
    "created_at": {"type": "string"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_regex", "width", "height"],
      "properties": {
        "title_regex": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 320},
        "height": {"type": "integer", "minimum": 240}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "button"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "button": {"enum": [1, 2, 3]}
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "template_path", "template_size", "search_margin", "threshold"],
      "properties": {
        "enabled": {"type": "boolean"},
        "template_path": {"type": "string"},
        "template_size": {"type": "integer", "minimum": 24},
        "search_margin": {"type": "integer", "minimum": 0, "maximum": 64},
        "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "source_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_id", "screenshot_path"],
      "properties": {
        "capture_id": {"type": "string"},
        "screenshot_path": {"type": "string"}
      }
    }
  }
}
